# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec for the pure-Python Qt (PySide6) desktop client.

Build from the repository root (the spec resolves its own paths):

    .venv/bin/python -m PyInstaller --noconfirm --clean p2pchat/tools/desktop.spec

Output: ``dist/p2p-desktop/p2p-desktop`` (one-folder bundle).

Platform status: **Linux x86_64 is built and launched locally.** Windows and
macOS are **unverified** — no host or CI run has ever executed this spec there.
The same command is the recipe on every platform; on Windows use
``.venv\\Scripts\\python.exe`` as the interpreter.

Why the explicit collection below:
* aiortc/aioice/aioquic import C extensions and submodules that static analysis
  cannot always follow, and the native adapter is imported by dotted path;
* Qt: PyInstaller's PySide6 hook collects the Qt libraries and the platform
  plugins (``PySide6/Qt/plugins/platforms/libqxcb.so`` for X11, plus the
  offscreen/minimal plugins used headlessly). The build asserts after COLLECT
  that the platform plugin really landed in the bundle, instead of trusting the
  hook silently;
* ``tkinter``/``_tkinter`` are **excluded**: the Tk shell was replaced by Qt (the
  Tk runtime on this host is not linked against Xft and rendered 中文 as blanks);
* only the Python modules of ``p2pchat`` are bundled — build outputs,
  node_modules, releases and research evidence are deliberately excluded, and the
  interface wording ships as package data;
* LGPL: Qt/PySide6 are linked dynamically and their license texts ship inside the
  bundle (``licenses/``); see ``p2pchat/python_desktop/licenses/PYSIDE6-NOTICE.txt``.

The frozen entry point is generated next to this spec by the spec itself, so the
packaged binary always delegates to ``p2pchat.python_desktop.app.main`` and
cannot drift from the module CLI.
"""
import os
import sys

from PyInstaller.utils.hooks import collect_dynamic_libs, collect_submodules, copy_metadata

ROOT = os.path.abspath(os.path.join(SPECPATH, os.pardir, os.pardir))  # SPECPATH is <root>/p2pchat/tools

# --------------------------------------------------------------------------- entry
ENTRY = os.path.join(SPECPATH, 'desktop-entry.py')
with open(ENTRY, 'w', encoding='utf-8') as handle:
    handle.write(
        '"""Generated by p2pchat/tools/desktop.spec; do not edit or commit."""\n'
        'import sys\n'
        'from p2pchat.python_desktop.app import main\n'
        '\n'
        'if __name__ == "__main__":\n'
        '    sys.exit(main())\n'
    )

hidden = []
hidden += collect_submodules('aiortc')
hidden += collect_submodules('aioice')
hidden += collect_submodules('aioquic')
hidden += collect_submodules('aiohttp')
hidden += collect_submodules('cryptography')
# Only the real source tree; p2pchat also contains build outputs and vendored
# node_modules that must never end up inside the bundle.
hidden += [
    name
    for name in collect_submodules('p2pchat')
    if not any(
        part in {'tests', 'review', 'verification', 'node_modules', 'releases', 'dist-web', 'android', 'android-native'}
        for part in name.split('.')
    )
]
hidden += [
    'PySide6',
    'PySide6.QtCore',
    'PySide6.QtGui',
    'PySide6.QtWidgets',
    'shiboken6',
    'av',
    'av.audio',
    'av.packet',
    'cffi',
    '_cffi_backend',
    'pylibsrtp',
    'pyee',
    'OpenSSL',
    'p2pchat.python_desktop.app',
    'p2pchat.python_desktop.selftest',
    'p2pchat.python_desktop.qt_ui',
]

# PyAV / libsrtp / cryptography wheels ship shared objects that PyInstaller does
# not always discover from pure-Python usage.
binaries = []
for module in ('av', 'cryptography', 'aioquic', 'aiortc', 'pylibsrtp'):
    try:
        binaries += collect_dynamic_libs(module)
    except Exception:
        pass

# Qt: the PySide6 hook picks up libQt6*.so and the platform plugins. Which
# directory holds them depends on the wheel: PySide6 ships them either under
# ``Qt/plugins`` or directly under ``plugins``, and the layout differs between
# Linux and Windows. Probe both instead of assuming one, so a Windows build does
# not fail on a path that only exists on Linux.
QT_PLUGIN_ROOT = None
QT_PLUGIN_CANDIDATES = []
try:
    import PySide6

    _pyside_dir = os.path.dirname(PySide6.__file__)
    QT_PLUGIN_CANDIDATES = [
        os.path.join(_pyside_dir, 'Qt', 'plugins'),
        os.path.join(_pyside_dir, 'plugins'),
    ]
    QT_PLUGIN_ROOT = next(
        (path for path in QT_PLUGIN_CANDIDATES if os.path.isdir(os.path.join(path, 'platforms'))),
        None,
    )
except Exception:
    QT_PLUGIN_ROOT = None

# Interface wording and the retained web client are the only data assets the
# desktop app needs.
datas = [
    (os.path.join(ROOT, 'p2pchat', 'web'), 'p2pchat/web'),
    (os.path.join(ROOT, 'p2pchat', 'docs', 'METHODS-PLAIN.md'), 'p2pchat/docs'),
    # LGPL-3.0/GPL-3.0 texts must travel with the dynamically linked Qt libraries.
    (os.path.join(ROOT, 'p2pchat', 'python_desktop', 'licenses'), 'licenses'),
]
# Distribution metadata so the packaged app can report the exact Qt/PySide6 it
# ships (``importlib.metadata.version``) instead of "版本未知".
for distribution in ('PySide6-Essentials', 'shiboken6'):
    try:
        datas += copy_metadata(distribution)
    except Exception:
        pass

excludes = [
    'PyQt5', 'PyQt6', 'PySide2', 'matplotlib', 'numpy', 'pandas',
    'notebook', 'IPython', 'pytest', 'setuptools', 'pip',
    # The Tk shell is gone: never bundle tkinter again.
    'tkinter', '_tkinter', 'Tkinter',
]
if sys.platform != 'win32':
    excludes += ['win32com', 'win32api', 'pythoncom']
if sys.platform == 'darwin':
    excludes += ['PyObjCTools']

a = Analysis(
    [ENTRY],
    pathex=[ROOT],
    binaries=binaries,
    datas=datas,
    hiddenimports=hidden,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=excludes,
    noarchive=False,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name='p2p-desktop',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=True,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)

coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    upx_exclude=[],
    name='p2p-desktop',
)

# Prove the Qt platform plugin really shipped: without the platform plugin the
# packaged GUI cannot start, and a silent hook miss would only show up on the
# user's box. Probe both bundle layouts (.so on Linux, .dll on Windows) and fail
# with the probed paths instead of quietly collecting nothing.
_BUNDLE_INTERNAL = os.path.join(DISTPATH, 'p2p-desktop', '_internal')
BUNDLE_PLUGIN_CANDIDATES = [
    os.path.join(_BUNDLE_INTERNAL, 'PySide6', 'Qt', 'plugins', 'platforms'),
    os.path.join(_BUNDLE_INTERNAL, 'PySide6', 'plugins', 'platforms'),
]
PLATFORM_PLUGIN = next((path for path in BUNDLE_PLUGIN_CANDIDATES if os.path.isdir(path)), None)
if PLATFORM_PLUGIN is None:
    raise SystemExit(
        'QT PLATFORM PLUGIN DIRECTORY NOT FOUND in the bundle. Probed: '
        + ', '.join(BUNDLE_PLUGIN_CANDIDATES)
        + ' (bundle internal dir: '
        + (', '.join(sorted(os.listdir(_BUNDLE_INTERNAL))) if os.path.isdir(_BUNDLE_INTERNAL) else 'missing')
        + ')'
    )
if QT_PLUGIN_ROOT is None:
    raise SystemExit(
        'QT PLUGIN DIRECTORY NOT FOUND in the installed PySide6. Probed: '
        + ', '.join(QT_PLUGIN_CANDIDATES or ['<PySide6 import failed>'])
        + ' — refusing to build a bundle whose platform plugin was never collected.'
    )
expected = sorted(
    name
    for name in os.listdir(os.path.join(QT_PLUGIN_ROOT, 'platforms'))
    if name.endswith(('.so', '.dll'))
)
found = sorted(name for name in os.listdir(PLATFORM_PLUGIN) if name.endswith(('.so', '.dll')))
missing = [name for name in expected if name not in found]
if not found or missing:
    raise SystemExit(
        'QT PLATFORM PLUGINS MISSING in the bundle: '
        + (', '.join(missing) if missing else 'none found')
        + f' (bundle dir: {PLATFORM_PLUGIN})'
    )
license_dir = os.path.join(_BUNDLE_INTERNAL, 'licenses')
if not os.path.isdir(license_dir):
    raise SystemExit(f'LGPL license texts missing from the bundle: {license_dir}')

# The generated entry script is throwaway build input, not a source file.
try:
    os.unlink(ENTRY)
except OSError:
    pass
