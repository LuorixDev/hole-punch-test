{
  "name": "p2p-observatory-chat",
  "version": "0.2.0",
  "private": true,
  "description": "Strict P2P connectivity and chat diagnostics (web + Capacitor Android; desktop is pure Python)",
  "scripts": {
    "sync:web": "node tools/sync-web.cjs",
    "build:native": "node tools/build-native.cjs",
    "test:platform": "node --test tests/platform/*.test.cjs",
    "desktop:linux": "cd .. && .venv/bin/python -m PyInstaller --noconfirm --clean p2pchat/tools/desktop.spec",
    "desktop:selftest": "cd .. && .venv/bin/python -m p2pchat.python_desktop.app --self-test",
    "android:add": "npm run sync:web && cap add android",
    "android:sync": "npm run sync:web && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  },
  "overrides": {
    "xcode": {"uuid": "11.1.1"}
  }
}
